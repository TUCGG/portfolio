---
import {Image} from 'astro:assets';

import photo from '../assets/profile.webp';
import {profile} from '../data/profile.ts';
import {withBase} from '../lib/base.ts';
---

<section id="about" class="section about" aria-labelledby="about-title">
  <Image class="photo" src={photo} alt={`${profile.name} 프로필 사진`} widths={[96, 192]} sizes="96px" />
  <h1 id="about-title">{profile.name}</h1>
  <p class="headline">{profile.headline}</p>
  <ul class="links">
    <li><a href={`mailto:${profile.email}`}>메일</a></li>
    <li><a href={profile.github}>GitHub</a></li>
    <li><a href={profile.velog}>velog</a></li>
    <li><a class="pdf" href={withBase('/resume.pdf')}>PDF 다운로드</a></li>
  </ul>
  <div class="intro">
    {profile.about.map((p) => <p>{p}</p>)}
  </div>
</section>

<style>
  .about {
    padding-top: 5rem;
  }

  /* 데스크톱은 메뉴에 사진이 있어서 모바일에서만 보인다 */
  .photo {
    display: block;
    width: 96px;
    height: 96px;
    object-fit: cover;
    object-position: 50% 18%;
    border-radius: 50%;
    /* 증명사진 배경이 흰색이라 테두리로 원을 드러낸다 */
    box-shadow: 0 0 0 1px var(--rule);
    margin-bottom: 1.5rem;
  }

  @media (min-width: 1024px) {
    .photo {
      display: none;
    }
  }

  h1 {
    font-size: clamp(2.75rem, 7vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .headline {
    margin-top: 1rem;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.5;
    max-width: 30em;
  }

  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: 1.5rem;
  }

  .pdf {
    display: inline-block;
    padding: 0.25rem 0.875rem;
    border: 1px solid var(--accent);
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
  }

  .pdf:hover {
    background: var(--accent);
    color: var(--bg);
  }

  .intro {
    display: grid;
    gap: 0.75rem;
    margin-top: 2.5rem;
    max-width: 38em;
  }
</style>
