---
import {profile} from '../data/profile.ts';
---

<section id="interests" class="section" aria-labelledby="interests-title">
  <h2 id="interests-title">취미</h2>
  <ul class="grid">
    {
      profile.interests.map((i) => (
        <li>
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              {i.icon === 'bowling' && (
                <>
                  <circle cx="12" cy="12" r="9" />
                  <circle cx="10" cy="8.5" r="1.1" />
                  <circle cx="14" cy="8.5" r="1.1" />
                  <circle cx="12" cy="11.6" r="1.1" />
                </>
              )}
              {i.icon === 'gym' && (
                <>
                  <path d="M6.5 7v10M17.5 7v10M3.5 9.5v5M20.5 9.5v5M6.5 12h11" />
                </>
              )}
              {i.icon === 'whisky' && (
                <>
                  <path d="M5 5h14l-1.4 13.3a2 2 0 0 1-2 1.7H8.4a2 2 0 0 1-2-1.7L5 5z" />
                  <path d="M5.8 12h12.4" />
                  <path d="M9.5 8.2l2.6-.8.8 2.6-2.6.8z" />
                </>
              )}
              {i.icon === 'game' && (
                <>
                  <path d="M7.5 8h9a4.5 4.5 0 0 1 4.5 4.5v1.8a2.7 2.7 0 0 1-4.9 1.6L14.6 14H9.4l-1.5 1.9A2.7 2.7 0 0 1 3 14.3v-1.8A4.5 4.5 0 0 1 7.5 8z" />
                  <path d="M7.5 10.5v3M6 12h3" />
                  <circle cx="15.5" cy="11" r=".6" />
                  <circle cx="17.2" cy="12.7" r=".6" />
                </>
              )}
            </svg>
          </span>
          <span class="name">{i.name}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
  }

  .icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--side);
    color: var(--side-accent);
  }

  .name {
    font-weight: 600;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    li {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
