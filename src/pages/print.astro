---
import {Image} from 'astro:assets';
import {getCollection} from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import photo from '../assets/profile.webp';
import {profile} from '../data/profile.ts';
import {formatDuration, formatPeriod, monthsBetween} from '../lib/period.ts';
import {sortProjects} from '../lib/projects.ts';

const projects = sortProjects(await getCollection('projects'));
const personal = projects.filter((p) => p.data.company === '개인');
const host = (url: string) => url.replace(/^https?:\/\//, '');
const detailUrl = (id: string) => `${profile.siteUrl}/projects/${id}/`;
const {education, certificates} = profile;
---

<BaseLayout title={`${profile.name} 이력서`} description={profile.headline} noindex>
  <main id="main" class="sheet">
    <header class="head">
      <div>
        <h1>{profile.name}</h1>
        <p class="headline">{profile.headline}</p>
        <ul class="contact">
          <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          <li><a href={profile.siteUrl}>{host(profile.siteUrl)}</a></li>
          <li><a href={profile.github}>{host(profile.github)}</a></li>
          <li><a href={profile.velog}>{host(profile.velog)}</a></li>
        </ul>
        <p class="hobby">취미: {profile.interests.map((i) => i.name).join(', ')}</p>
      </div>
      <Image class="photo" src={photo} alt={`${profile.name} 프로필 사진`} widths={[240]} sizes="24mm" loading="eager" />
    </header>

    <section>
      <h2>소개</h2>
      {profile.about.map((p) => <p>{p}</p>)}
    </section>

    <section>
      <h2>경력 <span class="total">총 {formatDuration(profile.career.reduce((sum, c) => sum + monthsBetween(c.start, c.end), 0))}</span></h2>
      {
        profile.career.map((c) => (
          <div class="block">
            <div class="row">
              <h3>{c.company}</h3>
              <span class="date">{formatPeriod(c.start, c.end)}</span>
            </div>
            <p class="sub">
              {c.team} {c.position}, {c.role} | {formatDuration(monthsBetween(c.start, c.end))}
            </p>
            <p class="summary">{c.summary}</p>
            {c.details.map((d) => (
              <div class="group">
                {d.title && <p class="group-title">{d.title}</p>}
                <ul class="dash">
                  {d.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))}
            {projects.some((p) => p.data.company === c.company) && (
              <div class="group">
                <p class="group-title">주요 프로젝트</p>
                <ul class="dash">
                  {projects
                    .filter((p) => p.data.company === c.company)
                    .map((p) => (
                      <li class="row">
                        <span>
                          {p.data.title} <a class="link" href={detailUrl(p.id)}>{host(detailUrl(p.id))}</a>
                        </span>
                        <span class="date">{formatPeriod(p.data.start, p.data.end)}</span>
                      </li>
                    ))}
                </ul>
              </div>
            )}
          </div>
        ))
      }
    </section>

    {
      personal.length > 0 && (
        <section>
          <h2>개인 프로젝트</h2>
          {personal.map((p) => (
            <div class="project">
              <div class="row">
                <h4>{p.data.title}</h4>
                <span class="date">{formatPeriod(p.data.start, p.data.end)}</span>
              </div>
              <p class="sub">
                {p.data.role} | {p.data.stack.join(', ')}
              </p>
              <ul class="dash">
                {p.data.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
              <p class="link"><a href={detailUrl(p.id)}>{host(detailUrl(p.id))}</a></p>
            </div>
          ))}
        </section>
      )
    }

    <section>
      <h2>기술 스택</h2>
      <dl class="skills">
        {
          profile.skills.map((s) => (
            <div>
              <dt>{s.group}</dt>
              <dd>{s.items.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      (education.length > 0 || certificates.length > 0) && (
        <section>
          <h2>{certificates.length > 0 ? '학력·자격' : '학력'}</h2>
          {education.map((e) => (
            <div class="row">
              <span>
                {[e.school, e.major].filter(Boolean).join(' ')} ({e.status})
              </span>
              <span class="date">{e.start ? formatPeriod(e.start, e.end) : e.end.replace('-', '.')}</span>
            </div>
          ))}
          {certificates.map((c) => (
            <div class="row">
              <span>
                {c.name}, {c.issuer}
              </span>
              <span class="date">{c.date}</span>
            </div>
          ))}
        </section>
      )
    }
  </main>
</BaseLayout>

<style is:global>
  @page {
    size: A4;
    margin: 10mm;
  }

  @media print {
    .skip {
      display: none;
    }
  }

  .sheet {
    max-width: 190mm;
    margin: 0 auto;
    padding: 12mm 0;
    font-size: 10pt;
    line-height: 1.45;
  }

  @media print {
    .sheet {
      padding: 0;
    }
  }

  .sheet h1 {
    font-size: 22pt;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .sheet .headline {
    margin-top: 2mm;
    font-size: 11pt;
    font-weight: 500;
  }

  .sheet .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 6mm;
  }

  .sheet .photo {
    width: 24mm;
    height: 30mm;
    object-fit: cover;
    object-position: 50% 15%;
    border-radius: 1.5mm;
  }

  .sheet a {
    color: inherit;
    text-decoration: none;
  }

  .sheet .hobby {
    margin-top: 1mm;
    color: var(--muted);
  }

  .sheet .contact {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1mm 5mm;
    margin-top: 2mm;
    color: var(--muted);
  }

  .sheet section {
    margin-top: 4.5mm;
    break-inside: auto;
  }

  .sheet h2 {
    font-size: 11pt;
    font-weight: 700;
    padding-bottom: 1mm;
    margin-bottom: 2.5mm;
    border-bottom: 1px solid var(--ink);
  }

  .sheet h3 {
    font-size: 11pt;
    font-weight: 700;
  }

  .sheet h4 {
    font-size: 10pt;
    font-weight: 600;
  }

  .sheet .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 4mm;
  }

  .sheet .date {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .sheet .sub {
    color: var(--muted);
  }

  .sheet .dash {
    list-style: none;
    margin-top: 1mm;
  }

  .sheet .dash > li {
    position: relative;
    padding-left: 3.5mm;
  }

  .sheet .dash > li::before {
    content: '-';
    position: absolute;
    left: 0;
    color: var(--muted);
  }

  .sheet .project {
    margin-top: 3mm;
    padding-left: 4mm;
    border-left: 1px solid var(--rule);
    break-inside: avoid;
  }

  .sheet .total {
    margin-left: 2mm;
    color: var(--accent);
    font-size: 10pt;
  }

  .sheet .summary {
    margin-top: 1mm;
  }

  .sheet .group {
    margin-top: 1mm;
  }

  .sheet .group-title {
    font-weight: 600;
  }

  .sheet .block + .block {
    margin-top: 4mm;
  }

  .sheet .link {
    color: var(--accent);
    font-size: 9pt;
  }

  /* 2페이지에 맞추려고 기술 스택은 두 칸으로 놓는다 */
  .sheet .skills {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5mm 6mm;
  }

  .sheet .skills > div {
    display: grid;
    grid-template-columns: 26mm 1fr;
    gap: 2mm;
  }

  .sheet .skills dt {
    color: var(--muted);
  }
</style>
