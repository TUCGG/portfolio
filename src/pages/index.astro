---
import {getCollection} from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/About.astro';
import Career from '../components/Career.astro';
import Contact from '../components/Contact.astro';
import Education from '../components/Education.astro';
import Interests from '../components/Interests.astro';
import Posts from '../components/Posts.astro';
import Projects from '../components/Projects.astro';
import Sidebar from '../components/Sidebar.astro';
import Skills from '../components/Skills.astro';
import {profile} from '../data/profile.ts';
import {sortProjects} from '../lib/projects.ts';
import {fetchVelogPosts, mergePosts} from '../lib/velog.ts';

const projects = sortProjects(await getCollection('projects'));
// 대표 글이 최근 글과 겹쳐도 최근 글이 5개 남도록 넉넉히 가져온다.
const posts = mergePosts(profile.pinnedPosts, await fetchVelogPosts(profile.velogHandle, 5 + profile.pinnedPosts.length));
const personal = projects.filter((p) => p.data.company === '개인');
const hasEducation = profile.education.length > 0 || profile.certificates.length > 0;

const sections = [
  {id: 'about', label: '소개'},
  {id: 'career', label: '경력'},
  ...(personal.length > 0 ? [{id: 'projects', label: '프로젝트'}] : []),
  {id: 'posts', label: '기술 글'},
  {id: 'skills', label: '기술 스택'},
  {id: 'interests', label: '취미'},
  ...(hasEducation ? [{id: 'education', label: profile.certificates.length > 0 ? '학력·자격' : '학력'}] : []),
  {id: 'contact', label: '연락처'}
];
---

<BaseLayout title={`${profile.name} 포트폴리오`} description={profile.headline}>
  <Sidebar sections={sections} />
  <main id="main">
    <About />
    <Career projects={projects} />
    {personal.length > 0 && <Projects projects={personal} />}
    <Posts pinned={posts.pinned} recent={posts.recent} />
    <Skills />
    <Interests />
    <Education />
    <Contact />
  </main>
</BaseLayout>

<style>
  main {
    max-width: calc(var(--measure) + 2.5rem);
    padding-inline: 1.25rem;
  }

  @media (min-width: 1024px) {
    main {
      max-width: none;
      margin-left: var(--side-width);
      padding-inline: 4rem;
    }

    main > :global(*) {
      max-width: var(--measure);
    }
  }
</style>
